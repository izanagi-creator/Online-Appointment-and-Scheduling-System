+import Icon from './Icon.jsx'
+import { addDays, longDate, minToStr, to12h, todayStr } from '../lib/dates.js'
+
+const SLOT = 30  // minutes per clickable row
+const PX = 1.4   // pixels per minute
+
+export default function DaySchedule({ date, day, onDate, onBook, onEdit }) {
+  const isToday = date === todayStr()
+  const live = day ? day.appointments.filter((a) => a.status !== 'cancelled') : []
+  const hidden = day ? day.appointments.length - live.length : 0
+  const pct = day ? Math.round((day.bookedMinutes / day.totalMinutes) * 100) : 0
+  const level = pct >= 90 ? 'hot' : pct >= 70 ? 'warm' : ''
+  const rows = day ? (day.workEnd - day.workStart) / SLOT : 0
+
+  return (
+    <>
+      <div className="card-head">
+        <div className="daynav">
+          <button type="button" className="iconbtn" onClick={() => onDate(addDays(date, -1))} aria-label="Previous day">
+            <Icon name="chevL" />
+          </button>
+          <h2>{longDate(date)}</h2>
+          <button type="button" className="iconbtn" onClick={() => onDate(addDays(date, 1))} aria-label="Next day">
+            <Icon name="chevR" />
+          </button>
+          <button type="button" className="btn" onClick={() => onDate(todayStr())} disabled={isToday}>Today</button>
+          <input type="date" className="datepick" value={date} aria-label="Pick a date"
+            onChange={(e) => e.target.value && onDate(e.target.value)} />
+        </div>
+      </div>
+
+      {day ? (
+        <>
+          <div className="daymeta">
+            <span>{live.length} {live.length === 1 ? 'appointment' : 'appointments'}</span>
+            <div className={'bar ' + level}><i style={{ width: pct + '%' }} /></div>
+            <span>{pct}% booked{hidden > 0 ? `, ${hidden} cancelled hidden` : ''}</span>
+          </div>
+
+          <div className="timeline" style={{ height: rows * SLOT * PX }}>
+            {Array.from({ length: rows }, (_, i) => {
+              const start = day.workStart + i * SLOT
+              const label = to12h(minToStr(start))
+              return (
+                <button key={start} type="button" className={'slot' + (i % 2 === 0 ? ' hour' : '')}
+                  style={{ top: i * SLOT * PX, height: SLOT * PX }}
+                  onClick={() => onBook(date, minToStr(start))} aria-label={`Book ${label}`}>
+                  <span className="slot-time">{i % 2 === 0 ? label : ''}</span>
+                  <span className="slot-add"><Icon name="plus" size={16} /></span>
+                </button>
+              )
+            })}
+
+            {live.map((a) => (
+              <button key={a.id} type="button" className={`appt ${a.status}${a.duration <= 15 ? ' short' : ''}`}
+                style={{ top: (a.startMin - day.workStart) * PX, height: a.duration * PX - 2 }}
+                onClick={() => onEdit(a)} aria-label={`Edit ${a.title}, ${to12h(a.start)}`}>
+                <b>{a.title}</b>
+                <span>{to12h(a.start)} - {to12h(a.end)} with {a.client}</span>
+              </button>
+            ))}
+          </div>
+        </>
+      ) : (
+        <p className="empty">Loading schedule...</p>
+      )}
+    </>
+  )
+}
