diff --git a/client/src/lib/useNow.js b/client/src/lib/useNow.js
new file mode 100644
index 0000000..656e4cd
--- /dev/null
+++ b/client/src/lib/useNow.js
@@ -0,0 +1,12 @@
+import { useEffect, useState } from 'react'
+
+// The current time as minutes since midnight, refreshed every 30 seconds.
+export function useNow() {
+  const get = () => { const d = new Date(); return d.getHours() * 60 + d.getMinutes() }
+  const [now, setNow] = useState(get)
+  useEffect(() => {
+    const id = setInterval(() => setNow(get()), 30000)
+    return () => clearInterval(id)
+  }, [])
+  return now
+}
