diff --git a/client/src/components/DayView.jsx b/client/src/components/DayView.jsx
new file mode 100644
index 0000000..803c083
--- /dev/null
+++ b/client/src/components/DayView.jsx
@@ -0,0 +1,56 @@
+import Icon from './Icon.jsx'
+import { minToStr, to12h, todayStr } from '../lib/dates.js'
+import { typeColor } from '../lib/types.js'
+import { useNow } from '../lib/useNow.js'
+
+const SLOT = 30  // minutes per clickable row
+const PX = 1.4   // pixels per minute
+
+export default function DayView({ date, day, onBook, onEdit }) {
+  const now = useNow()
+  // while the next day is loading, show a skeleton instead of the previous day's data
+  if (!day || day.date !== date) return <div className="skeleton" style={{ height: 360 }} aria-label="Loading schedule" />
+
+  const live = day.appointments.filter((a) => a.status !== 'cancelled')
+  const hidden = day.appointments.length - live.length
+  const pct = Math.round((day.bookedMinutes / day.totalMinutes) * 100)
+  const level = pct >= 90 ? 'hot' : pct >= 70 ? 'warm' : ''
+  const rows = (day.workEnd - day.workStart) / SLOT
+  const showNow = date === todayStr() && now >= day.workStart && now <= day.workEnd
+
+  return (
+    <>
+      <div className="daymeta">
+        <span>{live.length} {live.length === 1 ? 'appointment' : 'appointments'}</span>
+        <div className={'bar ' + level}><i style={{ width: pct + '%' }} /></div>
+        <span>{pct}% booked{hidden > 0 ? `, ${hidden} cancelled hidden` : ''}</span>
+      </div>
+
+      <div className="timeline" style={{ height: rows * SLOT * PX }}>
+        {Array.from({ length: rows }, (_, i) => {
+          const start = day.workStart + i * SLOT
+          const label = to12h(minToStr(start))
+          return (
+            <button key={start} type="button" className={'slot' + (i % 2 === 0 ? ' hour' : '')}
+              style={{ top: i * SLOT * PX, height: SLOT * PX }}
+              onClick={() => onBook(date, minToStr(start))} aria-label={`Book ${label}`}>
+              <span className="slot-time">{i % 2 === 0 ? label : ''}</span>
+              <span className="slot-add"><Icon name="plus" size={16} /></span>
+            </button>
+          )
+        })}
+
+        {live.map((a) => (
+          <button key={a.id} type="button" className={`appt ${a.status}${a.duration <= 15 ? ' short' : ''}`}
+            style={{ top: (a.startMin - day.workStart) * PX, height: a.duration * PX - 2, '--c': typeColor(a.type) }}
+            onClick={() => onEdit(a)} aria-label={`Edit ${a.title}, ${to12h(a.start)}`}>
+            <b>{a.status === 'completed' && <Icon name="check" size={13} />} {a.title}</b>
+            <span>{to12h(a.start)} - {to12h(a.end)} with {a.client}</span>
+          </button>
+        ))}
+
+        {showNow && <div className="nowline" style={{ top: (now - day.workStart) * PX }} aria-hidden="true"><i /></div>}
+      </div>
+    </>
+  )
+}
diff --git a/client/src/components/Schedule.jsx b/client/src/components/Schedule.jsx
new file mode 100644
index 0000000..5e7efb4
--- /dev/null
+++ b/client/src/components/Schedule.jsx
@@ -0,0 +1,40 @@
+import Icon from './Icon.jsx'
+import DayView from './DayView.jsx'
+import WeekView from './WeekView.jsx'
+import { periodLabel, shiftDate, todayStr } from '../lib/dates.js'
+
+const VIEWS = [['day', 'Day'], ['week', 'Week']]
+
+export default function Schedule({ view, onView, date, onDate, day, appointments, config, onBook, onEdit }) {
+  const pickDay = (d) => { onDate(d); onView('day') }
+
+  return (
+    <>
+      <div className="card-head">
+        <div className="daynav">
+          <button type="button" className="iconbtn" onClick={() => onDate(shiftDate(date, view, -1))} aria-label={`Previous ${view}`}>
+            <Icon name="chevL" />
+          </button>
+          <h2>{periodLabel(date, view)}</h2>
+          <button type="button" className="iconbtn" onClick={() => onDate(shiftDate(date, view, 1))} aria-label={`Next ${view}`}>
+            <Icon name="chevR" />
+          </button>
+          <button type="button" className="btn" onClick={() => onDate(todayStr())} disabled={date === todayStr()}>Today</button>
+          <input type="date" className="datepick" value={date} aria-label="Pick a date"
+            onChange={(e) => e.target.value && onDate(e.target.value)} />
+        </div>
+        <div className="seg" role="tablist" aria-label="Calendar view">
+          {VIEWS.map(([key, label]) => (
+            <button key={key} type="button" role="tab" aria-selected={view === key}
+              className={view === key ? 'on' : ''} onClick={() => onView(key)}>{label}</button>
+          ))}
+        </div>
+      </div>
+
+      {view === 'day' && <DayView date={date} day={day} onBook={onBook} onEdit={onEdit} />}
+      {view === 'week' && (
+        <WeekView date={date} appointments={appointments} config={config} onBook={onBook} onEdit={onEdit} onPickDay={pickDay} />
+      )}
+    </>
+  )
+}
diff --git a/client/src/components/WeekView.jsx b/client/src/components/WeekView.jsx
new file mode 100644
index 0000000..d097fd3
--- /dev/null
+++ b/client/src/components/WeekView.jsx
@@ -0,0 +1,63 @@
+import { dayName, dayNum, longDate, minToStr, shortDate, to12h, todayStr, weekDays } from '../lib/dates.js'
+import { typeColor } from '../lib/types.js'
+import { useNow } from '../lib/useNow.js'
+
+const SLOT = 30
+const PX = 1.4
+
+export default function WeekView({ date, appointments, config, onBook, onEdit, onPickDay }) {
+  const now = useNow()
+  const days = weekDays(date)
+  const today = todayStr()
+  const start = config.workStart, end = config.workEnd
+  const rows = (end - start) / SLOT
+
+  return (
+    <div className="scroll">
+      <div className="week">
+        <div className="wgrid whead">
+          <div />
+          {days.map((d) => (
+            <button key={d} type="button" className={'whd' + (d === today ? ' today' : '')}
+              onClick={() => onPickDay(d)} aria-label={`Open ${longDate(d)}`}>
+              <span>{dayName(d)}</span><b>{dayNum(d)}</b>
+            </button>
+          ))}
+        </div>
+
+        <div className="wgrid wbody" style={{ height: rows * SLOT * PX }}>
+          <div className="waxis">
+            {Array.from({ length: rows / 2 }, (_, i) => (
+              <span key={i} style={{ top: i * 60 * PX }}>{to12h(minToStr(start + i * 60))}</span>
+            ))}
+          </div>
+
+          {days.map((d) => (
+            <div key={d} className={'wcol' + (d === today ? ' today' : '')}>
+              {Array.from({ length: rows }, (_, i) => {
+                const s = start + i * SLOT
+                return (
+                  <button key={s} type="button" className={'slot' + (i % 2 === 0 ? ' hour' : '')}
+                    style={{ top: i * SLOT * PX, height: SLOT * PX }}
+                    onClick={() => onBook(d, minToStr(s))} aria-label={`Book ${shortDate(d)}, ${to12h(minToStr(s))}`} />
+                )
+              })}
+
+              {appointments.filter((a) => a.date === d && a.status !== 'cancelled').map((a) => (
+                <button key={a.id} type="button" className={'wappt ' + a.status}
+                  style={{ top: (a.startMin - start) * PX, height: a.duration * PX - 2, '--c': typeColor(a.type) }}
+                  onClick={() => onEdit(a)} aria-label={`Edit ${a.title}, ${shortDate(a.date)} ${to12h(a.start)}`}>
+                  <b>{a.title}</b><span>{to12h(a.start)}</span>
+                </button>
+              ))}
+
+              {d === today && now >= start && now <= end && (
+                <div className="nowline" style={{ top: (now - start) * PX }} aria-hidden="true"><i style={{ left: -4 }} /></div>
+              )}
+            </div>
+          ))}
+        </div>
+      </div>
+    </div>
+  )
+}
diff --git a/client/src/lib/dates.js b/client/src/lib/dates.js
index 0cfeeb6..78578f0 100644
--- a/client/src/lib/dates.js
+++ b/client/src/lib/dates.js
@@ -33,3 +33,36 @@ export function nowRoundedUp() {
   const m = Math.ceil((d.getHours() * 60 + d.getMinutes()) / 15) * 15
   return minToStr(Math.min(m, 23 * 60 + 45))
 }
+
+// ---------- calendar helpers (weeks start on Monday) ----------
+export function startOfWeek(str) {
+  const d = parse(str)
+  d.setDate(d.getDate() - ((d.getDay() + 6) % 7))
+  return toDateStr(d)
+}
+export const weekDays = (str) => Array.from({ length: 7 }, (_, i) => addDays(startOfWeek(str), i))
+
+export function addMonths(str, n) {
+  const [y, m, d] = str.split('-').map(Number)
+  const last = new Date(y, m - 1 + n + 1, 0).getDate()
+  return toDateStr(new Date(y, m - 1 + n, Math.min(d, last)))
+}
+// 42 days (6 weeks) starting on the Monday on or before the 1st of the month
+export const monthGrid = (str) => Array.from({ length: 42 }, (_, i) => addDays(startOfWeek(str.slice(0, 8) + '01'), i))
+
+export const shiftDate = (str, view, dir) =>
+  view === 'month' ? addMonths(str, dir) : addDays(str, (view === 'week' ? 7 : 1) * dir)
+
+export const dayName = (str) => parse(str).toLocaleDateString('en-US', { weekday: 'short' })
+export const dayNum = (str) => Number(str.slice(8))
+
+export function periodLabel(str, view) {
+  if (view === 'month') return parse(str).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
+  if (view === 'week') {
+    const days = weekDays(str)
+    const a = parse(days[0]), b = parse(days[6])
+    const fmt = (d) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
+    return `${fmt(a)} - ${a.getMonth() === b.getMonth() ? b.getDate() : fmt(b)}, ${b.getFullYear()}`
+  }
+  return longDate(str)
+}
