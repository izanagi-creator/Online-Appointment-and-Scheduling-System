diff --git a/client/src/components/AppointmentForm.jsx b/client/src/components/AppointmentForm.jsx
new file mode 100644
index 0000000..2ec1499
--- /dev/null
+++ b/client/src/components/AppointmentForm.jsx
@@ -0,0 +1,74 @@
+import { useState } from 'react'
+import { to12h, minToStr } from '../lib/dates.js'
+
+const BLANK = { title: '', client: '', type: 'Meeting', date: '', start: '09:00', duration: 30, status: 'scheduled', notes: '' }
+
+export default function AppointmentForm({ initial, config, error, suggestion, onSave, onCancel }) {
+  const [v, setV] = useState({ ...BLANK, ...initial })
+  const set = (k) => (e) => setV({ ...v, [k]: e.target.value })
+  const editing = Boolean(initial && initial.id)
+
+  const starts = []
+  for (let m = config.workStart; m < config.workEnd; m += config.step) starts.push(minToStr(m))
+
+  return (
+    <form className="form" onSubmit={(e) => { e.preventDefault(); onSave({ ...v, duration: Number(v.duration) }) }}>
+      <h2>{editing ? 'Edit appointment' : 'New appointment'}</h2>
+
+      <label>Title
+        <input value={v.title} onChange={set('title')} placeholder="Initial consultation" autoFocus required />
+      </label>
+
+      <div className="grid2">
+        <label>Client / attendee
+          <input value={v.client} onChange={set('client')} placeholder="Maria Santos" required />
+        </label>
+        <label>Type
+          <select value={v.type} onChange={set('type')}>
+            {config.types.map((t) => <option key={t}>{t}</option>)}
+          </select>
+        </label>
+        <label>Date
+          <input type="date" value={v.date} onChange={set('date')} required />
+        </label>
+        <label>Start time
+          <select value={v.start} onChange={set('start')}>
+            {starts.map((s) => <option key={s} value={s}>{to12h(s)}</option>)}
+          </select>
+        </label>
+        <label>Duration
+          <select value={v.duration} onChange={set('duration')}>
+            {config.durations.map((d) => <option key={d} value={d}>{d} minutes</option>)}
+          </select>
+        </label>
+        {editing && (
+          <label>Status
+            <select value={v.status} onChange={set('status')}>
+              {config.statuses.map((s) => <option key={s} value={s}>{s[0].toUpperCase() + s.slice(1)}</option>)}
+            </select>
+          </label>
+        )}
+      </div>
+
+      <label>Notes
+        <input value={v.notes} onChange={set('notes')} placeholder="Bring last month's report" />
+      </label>
+
+      {error && (
+        <p className="error" role="alert">
+          {error}{' '}
+          {suggestion && (
+            <button type="button" className="link" onClick={() => setV({ ...v, start: suggestion })}>
+              Use {to12h(suggestion)}
+            </button>
+          )}
+        </p>
+      )}
+
+      <div className="actions">
+        <button type="submit" className="primary">{editing ? 'Save changes' : 'Book appointment'}</button>
+        <button type="button" onClick={onCancel}>Cancel</button>
+      </div>
+    </form>
+  )
+}
