@@ -0,0 +1,53 @@
+import { shortDate, to12h, todayStr } from '../lib/dates.js'
+
+export default function StatCards({ appointments, today, onBook, onEdit }) {
+  const t = todayStr()
+  const now = new Date()
+  const nowMin = now.getHours() * 60 + now.getMinutes()
+
+  const todays = appointments.filter((a) => a.date === t && a.status !== 'cancelled')
+  const doneToday = todays.filter((a) => a.status === 'completed').length
+  const upcoming = appointments.filter((a) => a.status === 'scheduled' && (a.date > t || (a.date === t && a.endMin > nowMin)))
+  const next = upcoming[0] // the list arrives sorted by date and time
+
+  const pct = today ? Math.round((today.bookedMinutes / today.totalMinutes) * 100) : 0
+  const level = pct >= 90 ? 'hot' : pct >= 70 ? 'warm' : ''
+
+  return (
+    <section className="summary" aria-label="Summary">
+      <div className="stat">
+        <div className="stat-label">Today</div>
+        <div className="stat-value">{todays.length}</div>
+        <div className={'bar ' + level} role="progressbar" aria-label="Today's schedule used"
+          aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100">
+          <i style={{ width: pct + '%' }} />
+        </div>
+        <div className="stat-sub">{doneToday} done, {pct}% of the day booked</div>
+      </div>
+
+      <div className="stat">
+        <div className="stat-label">Upcoming</div>
+        <div className="stat-value">{upcoming.length}</div>
+        <div className="stat-sub">scheduled from now on</div>
+      </div>
+
+      <div className="stat">
+        <div className="stat-label">Next appointment</div>
+        {next
+          ? <button type="button" className="stat-link" onClick={() => onEdit(next)}>{next.title}</button>
+          : <div className="stat-value">None</div>}
+        <div className="stat-sub">
+          {next ? `${shortDate(next.date)}, ${to12h(next.start)} with ${next.client}` : 'nothing scheduled'}
+        </div>
+      </div>
+
+      <div className="stat">
+        <div className="stat-label">Next free slot today</div>
+        {today && today.nextFree
+          ? <button type="button" className="stat-link" onClick={() => onBook(today.nextFree)}>{to12h(today.nextFree)}</button>
+          : <div className="stat-value">None</div>}
+        <div className="stat-sub">{today && today.nextFree ? 'tap to book 30 minutes' : 'no open 30 minute slot left'}</div>
+      </div>
+    </section>
+  )
+}
