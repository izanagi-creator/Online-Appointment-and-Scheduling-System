diff --git a/client/src/styles.css b/client/src/styles.css
index b10bade..25a0407 100644
--- a/client/src/styles.css
+++ b/client/src/styles.css
@@ -222,3 +222,25 @@ tr.is-cancelled .title { text-decoration: line-through; color: var(--mute); }
   background: color-mix(in srgb, var(--c) 16%, var(--surface)); border: 1px solid color-mix(in srgb, var(--c) 45%, transparent); border-left: 3px solid var(--c); }
 .wappt b { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 .wappt span { color: var(--mute); }
+
+/* ---------- month view ---------- */
+.month { min-width: 680px; }
+.mhead { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); padding-bottom: 6px; }
+.mhead span { text-align: center; color: var(--mute); font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
+.mgrid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
+.mcell { min-height: 108px; padding: 4px 5px 6px; display: flex; flex-direction: column; gap: 2px; min-width: 0;
+  border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
+.mcell.other { background: var(--surface2); }
+.mcell.other .mnum { color: var(--mute); opacity: .6; }
+.mcell.today { background: color-mix(in srgb, var(--brand) 7%, transparent); }
+.mtop { display: flex; justify-content: space-between; align-items: center; }
+.mnum { width: 26px; height: 26px; display: inline-grid; place-items: center; border-radius: 50%; border: 0; background: none; cursor: pointer; font-size: .84rem; font-weight: 600; }
+.mnum:hover { background: var(--surface2); }
+.mcell.today .mnum { background: var(--brand); color: var(--brand-ink); }
+.madd { opacity: 0; width: 22px; height: 22px; display: grid; place-items: center; border: 0; border-radius: 6px; background: none; color: var(--brand); cursor: pointer; }
+.mcell:hover .madd, .madd:focus-visible { opacity: 1; }
+.mchip { --c: var(--brand); text-align: left; padding: 1px 6px; font-size: .74rem; line-height: 1.5; cursor: pointer; color: var(--ink);
+  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-radius: 6px; border: 0; border-left: 3px solid var(--c);
+  background: color-mix(in srgb, var(--c) 15%, var(--surface)); }
+.mtime { color: var(--mute); font-weight: 600; }
+.mmore { text-align: left; background: none; border: 0; padding: 0 4px; color: var(--brand); font-size: .74rem; font-weight: 600; cursor: pointer; }
