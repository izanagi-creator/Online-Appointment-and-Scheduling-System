diff --git a/client/src/components/MonthView.jsx b/client/src/components/MonthView.jsx
new file mode 100644
index 0000000..7664374
--- /dev/null
+++ b/client/src/components/MonthView.jsx
@@ -0,0 +1,48 @@
+import Icon from './Icon.jsx'
+import { dayName, dayNum, longDate, monthGrid, shortDate, to12h, todayStr } from '../lib/dates.js'
+import { typeColor } from '../lib/types.js'
+
+const MAX = 3 // chips shown per day before "+N more"
+
+export default function MonthView({ date, appointments, onBook, onEdit, onPickDay }) {
+  const days = monthGrid(date)
+  const month = date.slice(0, 7)
+  const today = todayStr()
+
+  const byDate = {}
+  for (const a of appointments) {
+    if (a.status !== 'cancelled') (byDate[a.date] ||= []).push(a)
+  }
+
+  return (
+    <div className="scroll">
+      <div className="month">
+        <div className="mhead">{days.slice(0, 7).map((d) => <span key={d}>{dayName(d)}</span>)}</div>
+        <div className="mgrid">
+          {days.map((d) => {
+            const list = byDate[d] || []
+            return (
+              <div key={d} className={'mcell' + (d.slice(0, 7) !== month ? ' other' : '') + (d === today ? ' today' : '')}>
+                <div className="mtop">
+                  <button type="button" className="mnum" onClick={() => onPickDay(d)} aria-label={`Open ${longDate(d)}`}>{dayNum(d)}</button>
+                  <button type="button" className="madd" onClick={() => onBook(d, '09:00')} aria-label={`New appointment on ${shortDate(d)}`}>
+                    <Icon name="plus" size={14} />
+                  </button>
+                </div>
+                {list.slice(0, MAX).map((a) => (
+                  <button key={a.id} type="button" className={'mchip ' + a.status} style={{ '--c': typeColor(a.type) }}
+                    onClick={() => onEdit(a)} title={`${to12h(a.start)} ${a.title}`}>
+                    <span className="mtime">{to12h(a.start).replace(':00', '')}</span> {a.title}
+                  </button>
+                ))}
+                {list.length > MAX && (
+                  <button type="button" className="mmore" onClick={() => onPickDay(d)}>+{list.length - MAX} more</button>
+                )}
+              </div>
+            )
+          })}
+        </div>
+      </div>
+    </div>
+  )
+}
