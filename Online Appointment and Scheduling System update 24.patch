@@ -0,0 +1,52 @@
+import { shortDate, to12h, todayStr } from '../lib/dates.js'
+import { typeColor } from '../lib/types.js'
+
+export default function Sidebar({ appointments, types, onEdit }) {
+  const t = todayStr()
+  const now = new Date()
+  const nowMin = now.getHours() * 60 + now.getMinutes()
+
+  const upcoming = appointments
+    .filter((a) => a.status === 'scheduled' && (a.date > t || (a.date === t && a.endMin > nowMin)))
+    .slice(0, 8) // the list arrives sorted by date and time
+
+  const groups = []
+  for (const a of upcoming) {
+    const last = groups[groups.length - 1]
+    if (last && last.date === a.date) last.items.push(a)
+    else groups.push({ date: a.date, items: [a] })
+  }
+
+  return (
+    <aside className="side">
+      <section className="card">
+        <div className="card-head"><h2>Coming up</h2></div>
+        {groups.length === 0 ? (
+          <p className="empty">Nothing coming up.</p>
+        ) : (
+          groups.map((g) => (
+            <div key={g.date} className="agday">
+              <h3>{g.date === t ? 'Today' : shortDate(g.date)}</h3>
+              {g.items.map((a) => (
+                <button key={a.id} type="button" className="agitem" style={{ '--c': typeColor(a.type) }}
+                  onClick={() => onEdit(a)} aria-label={`Open ${a.title}, ${to12h(a.start)}`}>
+                  <span className="agtime">{to12h(a.start)}</span>
+                  <span className="agtext"><b>{a.title}</b><span>{a.client}</span></span>
+                </button>
+              ))}
+            </div>
+          ))
+        )}
+      </section>
+
+      <section className="card">
+        <div className="card-head"><h2>Types</h2></div>
+        <ul className="legendlist">
+          {types.map((type) => (
+            <li key={type}><i className="typedot" style={{ '--c': typeColor(type) }} />{type}</li>
+          ))}
+        </ul>
+      </section>
+    </aside>
+  )
+}
