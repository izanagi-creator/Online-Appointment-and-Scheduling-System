+        <span className="logo"><Icon name="calendar" size={20} /></span>
+        <span>Appointly</span>
+      </div>
+      <div className="header-right">
+        <ThemeToggle />
+        <div className="userchip" title={user.username}>
+          <span className="avatar">{user.username[0].toUpperCase()}</span>
+          <span className="uname">{user.username}</span>
+        </div>
+        <button type="button" className="btn" onClick={onLogout} aria-label="Log out">
+          <Icon name="logout" size={16} /><span className="btn-text">Log out</span>
+        </button>
+      </div>
+    </header>
+  )
+}
