diff --git a/client/src/Dashboard.jsx b/client/src/Dashboard.jsx
new file mode 100644
index 0000000..fdab77f
--- /dev/null
+++ b/client/src/Dashboard.jsx
@@ -0,0 +1,107 @@
+import { useEffect, useRef, useState } from 'react'
+import { api } from './api.js'
+import { todayStr, nowRoundedUp } from './lib/dates.js'
+import Header from './components/Header.jsx'
+import Icon from './components/Icon.jsx'
+
+const DEFAULT_CONFIG = {
+  types: ['Meeting'], statuses: ['scheduled', 'completed', 'cancelled'], durations: [30], workStart: 480, workEnd: 1080, step: 15,
+}
+
+export default function Dashboard({ user, onLogout, onExpired }) {
+  const [appointments, setAppointments] = useState([])
+  const [config, setConfig] = useState(DEFAULT_CONFIG)
+  const [date, setDate] = useState(todayStr())
+  const [day, setDay] = useState(null)
+  const [today, setToday] = useState(null)
+  const [form, setForm] = useState({ open: false, key: 0, initial: {} })
+  const [formError, setFormError] = useState('')
+  const [suggestion, setSuggestion] = useState('')
+  const [toast, setToast] = useState('')
+  const [loadError, setLoadError] = useState('')
+  const toastTimer = useRef(null)
+
+  const fail = (e) => (e.status === 401 ? onExpired() : setLoadError(e.message))
+  const loadList = () => api.list().then((l) => { setAppointments(l); setLoadError('') }).catch(fail)
+
+  useEffect(() => {
+    api.config().then(setConfig).catch(() => {})
+    loadList()
+  }, [])
+
+  // Reload the timeline and the "today" numbers whenever the date or the list changes.
+  useEffect(() => {
+    api.day(date).then(setDay).catch(fail)
+    api.day(todayStr(), '&after=' + nowRoundedUp()).then(setToday).catch(fail)
+  }, [date, appointments])
+
+  const openForm = (initial = {}) => {
+    setFormError(''); setSuggestion('')
+    setForm((f) => ({ open: true, key: f.key + 1, initial: initial.id ? initial : { date, ...initial } }))
+  }
+  const closeForm = () => setForm((f) => ({ ...f, open: false }))
+
+  const notify = (text) => {
+    setToast(text)
+    clearTimeout(toastTimer.current)
+    toastTimer.current = setTimeout(() => setToast(''), 3000)
+  }
+
+  async function save(values) {
+    setFormError(''); setSuggestion('')
+    try {
+      const editing = Boolean(form.initial.id)
+      if (editing) await api.update(form.initial.id, values)
+      else await api.create(values)
+      closeForm()
+      notify(editing ? 'Appointment updated' : 'Appointment booked')
+      await loadList()
+    } catch (e) {
+      if (e.status === 401) return onExpired()
+      setFormError(e.message)
+      setSuggestion(e.suggestion || '')
+    }
+  }
+
+  async function remove(a) {
+    if (!window.confirm(`Delete "${a.title}" on ${a.date} at ${a.start}?`)) return
+    try {
+      await api.remove(a.id)
+    } catch (e) {
+      if (e.status === 401) return onExpired()
+      throw e
+    }
+    notify(`Deleted ${a.title}`)
+    loadList()
+  }
+
+  async function changeStatus(a, status) {
+    try {
+      await api.setStatus(a.id, status)
+      notify(status === 'completed' ? 'Marked as completed' : status === 'cancelled' ? 'Appointment cancelled' : 'Appointment reopened')
+      loadList()
+    } catch (e) {
+      if (e.status === 401) return onExpired()
+      notify(e.message) // for example: reopening would overlap another appointment
+    }
+  }
+
+  return (
+    <div className="app">
+      <Header user={user} onLogout={onLogout} />
+      <main className="page">
+        <div className="pagehead">
+          <div>
+            <h1>Dashboard</h1>
+            <p className="sub">Book appointments, avoid double-booking, and see your day at a glance.</p>
+          </div>
+        </div>
+        {loadError && <p className="error" role="alert">{loadError}</p>}
+
+
+
+      </main>
+
+    </div>
+  )
+}
