 const PORT = process.env.PORT || 3001
 
@@ -68,6 +68,21 @@ function recordFailure(key) {
   else f.count++
 }
 
+// ---------- double-booking protection ----------
+// The next start time (same day, same length) with no overlap, or null if the day is full.
+function suggestSlot(userId, v, ignoreId) {
+  for (let s = v.startMin + STEP; s + v.duration <= WORK_END; s += STEP) {
+    if (!findConflict(userId, v.date, s, v.duration, ignoreId)) return formatTime(s)
+  }
+  return null
+}
+
+function conflictError(userId, v, ignoreId) {
+  const c = findConflict(userId, v.date, v.startMin, v.duration, ignoreId)
+  if (!c) return null
+  return { error: `That time overlaps "${c.title}" (${c.start}-${c.end}).`, suggestion: suggestSlot(userId, v, ignoreId) }
+}
+
