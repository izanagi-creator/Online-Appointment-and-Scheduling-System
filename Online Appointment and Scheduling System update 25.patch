diff --git a/client/src/lib/dates.js b/client/src/lib/dates.js
index 78578f0..b7b0c88 100644
--- a/client/src/lib/dates.js
+++ b/client/src/lib/dates.js
@@ -66,3 +66,10 @@ export function periodLabel(str, view) {
   }
   return longDate(str)
 }
+
+export function greeting() {
+  const h = new Date().getHours()
+  return h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening'
+}
+// 15 -> "15m", 60 -> "1h", 90 -> "1h 30m"
+export const fmtDuration = (min) => (min < 60 ? `${min}m` : `${Math.floor(min / 60)}h${min % 60 ? ` ${min % 60}m` : ''}`)
diff --git a/client/src/styles.css b/client/src/styles.css
index 54e70b2..3f7fac9 100644
--- a/client/src/styles.css
+++ b/client/src/styles.css
@@ -260,3 +260,14 @@ tr.is-cancelled .title { text-decoration: line-through; color: var(--mute); }
 .legendlist { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 10px; font-size: .86rem; }
 .legendlist li { display: flex; align-items: center; gap: 8px; }
 @media (max-width: 1000px) { .workspace { grid-template-columns: minmax(0, 1fr); } }
+
+/* ---------- duration chips and card icons ---------- */
+.field { margin-bottom: 10px; }
+.flabel { display: block; font-size: .82rem; font-weight: 600; color: var(--mute); margin-bottom: 6px; }
+.chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.chip { padding: 6px 14px; border-radius: 99px; font-size: .86rem; font-weight: 600; cursor: pointer; color: var(--ink);
+  background: var(--surface); border: 1px solid var(--line); transition: background .1s; }
+.chip:hover { background: var(--surface2); }
+.chip.on { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
+.stat-top { display: flex; justify-content: space-between; align-items: center; }
+.stat-icon { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px; background: var(--brand-soft); color: var(--brand); }
