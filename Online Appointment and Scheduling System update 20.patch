diff --git a/client/src/lib/types.js b/client/src/lib/types.js
new file mode 100644
index 0000000..fb4dea1
--- /dev/null
+++ b/client/src/lib/types.js
@@ -0,0 +1,10 @@
+// Each appointment type has its own colour, used on the timeline, the calendar views and the list.
+export const TYPE_COLORS = {
+  Consultation: '#4f46e5',
+  Meeting: '#0e7490',
+  'Check-up': '#15803d',
+  Class: '#b45309',
+  Interview: '#be185d',
+  Other: '#64748b',
+}
+export const typeColor = (type) => TYPE_COLORS[type] || TYPE_COLORS.Other
diff --git a/client/src/styles.css b/client/src/styles.css
index e099e78..8e68017 100644
--- a/client/src/styles.css
+++ b/client/src/styles.css
@@ -95,13 +95,17 @@ input:focus, select:focus { border-color: var(--brand); outline: 3px solid color
 .slot-time { width: 72px; flex: none; color: var(--mute); font-size: .76rem; }
 .slot-add { margin-left: auto; opacity: 0; color: var(--brand); }
 .slot:hover .slot-add { opacity: 1; }
-.appt { position: absolute; left: 92px; right: 8px; z-index: 2; display: flex; flex-direction: column; justify-content: center;
-  text-align: left; padding: 3px 10px; border-radius: 9px; cursor: pointer; overflow: hidden;
-  color: var(--ink); background: var(--brand-soft); border: 1px solid var(--brand); border-left-width: 4px; }
+.appt { --c: var(--brand); position: absolute; left: 92px; right: 8px; z-index: 2; display: flex; flex-direction: column; justify-content: center;
+  text-align: left; padding: 3px 10px; border-radius: 9px; cursor: pointer; overflow: hidden; color: var(--ink);
+  background: color-mix(in srgb, var(--c) 14%, var(--surface)); border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
+  border-left: 4px solid var(--c); transition: transform .1s, box-shadow .1s; }
+.appt:hover { transform: translateX(2px); box-shadow: var(--shadow); }
 .appt b { font-size: .88rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 .appt span { font-size: .78rem; color: var(--mute); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
 .appt.short span { display: none; }
-.appt.completed { background: var(--ok-soft); border-color: var(--ok); }
+.appt.completed, .wappt.completed, .mchip.completed { opacity: .68; }
+.typecell { display: inline-flex; align-items: center; gap: 8px; }
+.typedot { width: 10px; height: 10px; border-radius: 50%; background: var(--c); flex: none; }
 
 /* ---------- appointment list ---------- */
 .toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 12px; }
