diff --git a/client/src/components/DaySchedule.jsx b/client/src/components/DaySchedule.jsx
index 9c1210e..0505753 100644
--- a/client/src/components/DaySchedule.jsx
+++ b/client/src/components/DaySchedule.jsx
@@ -1,5 +1,6 @@
 import Icon from './Icon.jsx'
 import { addDays, longDate, minToStr, to12h, todayStr } from '../lib/dates.js'
+import { typeColor } from '../lib/types.js'
 
 const SLOT = 30  // minutes per clickable row
 const PX = 1.4   // pixels per minute
@@ -53,9 +54,9 @@ export default function DaySchedule({ date, day, onDate, onBook, onEdit }) {
 
             {live.map((a) => (
               <button key={a.id} type="button" className={`appt ${a.status}${a.duration <= 15 ? ' short' : ''}`}
